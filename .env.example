# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# Required for real speech generation. Leave empty to run in Demo Mode.
ELEVENLABS_API_KEY=

# Optional: default model. "eleven_multilingual_v2" (default) or "eleven_v3".
ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional throttling (per client IP, per process).
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_HOUR=40
MAX_CONCURRENT_GENERATIONS=4
